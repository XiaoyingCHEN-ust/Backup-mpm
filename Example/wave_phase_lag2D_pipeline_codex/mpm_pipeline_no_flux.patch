+// Apply a moving impermeable circular boundary to the phase velocities. The
+// constraint is particle-local, so it follows the pipe and does not imprint a
+// stair-step set of fixed background nodes on the saturation field.
+template <unsigned Tdim>
+void mpm::ThreePhaseParticleLag<Tdim>::apply_rigid_circle_phase_no_flux(
+    const VectorDim&, const VectorDim&, double, double, double) noexcept {}
+
+template <>
+inline void mpm::ThreePhaseParticleLag<2>::
+    apply_rigid_circle_phase_no_flux(
+        const VectorDim& pipe_centre, const VectorDim& pipe_velocity,
+        double pipe_angular_velocity, double pipe_radius,
+        double influence_radius) noexcept {
+  if (this->material_id_ == 999 || influence_radius < pipe_radius) return;
+
+  const VectorDim radial = this->coordinates_ - pipe_centre;
+  const double distance = radial.norm();
+  if (!std::isfinite(distance) || distance <= 1.e-12 ||
+      distance > influence_radius)
+    return;
+
+  const VectorDim normal = radial / distance;
+  VectorDim tangent;
+  tangent << -normal[1], normal[0];
+  const VectorDim wall_velocity =
+      pipe_velocity + pipe_angular_velocity * pipe_radius * tangent;
+
+  auto remove_relative_normal_velocity =
+      [&](VectorDim* phase_velocity) {
+        const double relative_normal =
+            (*phase_velocity - wall_velocity).dot(normal);
+        *phase_velocity -= relative_normal * normal;
+      };
+  remove_relative_normal_velocity(&this->liquid_velocity_);
+  remove_relative_normal_velocity(&this->gas_velocity_);
+
+  // APIC is retained in the dynamic stage. Projecting the phase affine maps
+  // prevents their next particle-to-grid transfer from reintroducing a normal
+  // component at the wall; the solid affine map is deliberately untouched.
+  if (this->affine_mpm_) {
+    const Eigen::Matrix<double, 2, 2> tangent_projector =
+        Eigen::Matrix<double, 2, 2>::Identity() - normal * normal.transpose();
+    this->liquid_C_matrix_ = tangent_projector * this->liquid_C_matrix_;
+    this->gas_C_matrix_ = tangent_projector * this->gas_C_matrix_;
+  }
+}
