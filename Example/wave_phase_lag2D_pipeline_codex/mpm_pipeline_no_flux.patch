+template <unsigned Tdim>
+void mpm::ThermoMPMExplicitThreePhaseLag<Tdim>::
+    apply_rigid_pipeline_phase_no_flux() {
+  if (!rigid_pipeline_enabled_ || !rigid_pipeline_phase_no_flux_) return;
+
+  Eigen::Matrix<double, Tdim, 1> pipe_centre =
+      Eigen::Matrix<double, Tdim, 1>::Zero();
+  Eigen::Matrix<double, Tdim, 1> pipe_velocity =
+      Eigen::Matrix<double, Tdim, 1>::Zero();
+  pipe_centre[0] = rigid_pipeline_->centre().x();
+  pipe_centre[1] = rigid_pipeline_->centre().y();
+  pipe_velocity[0] = rigid_pipeline_->velocity().x();
+  pipe_velocity[1] = rigid_pipeline_->velocity().y();
+  const double influence_radius =
+      rigid_pipeline_->outer_radius() +
+      rigid_pipeline_phase_no_flux_band_factor_ *
+          rigid_pipeline_particle_radius_;
+
+  mesh_->iterate_over_particles(
+      std::bind(
+          &mpm::ParticleBase<Tdim>::apply_rigid_circle_phase_no_flux,
+          std::placeholders::_1, pipe_centre, pipe_velocity,
+          rigid_pipeline_->angular_velocity(), rigid_pipeline_->outer_radius(),
+          influence_radius));
+}
